# ---- Privy (G0a) ----
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Authorization key for server-side wallet API (quorum / intents)
PRIVY_AUTHORIZATION_PRIVATE_KEY=

# ---- The Graph (G0b) ----
# Substreams endpoint. Base mainnet:
#   base-mainnet.streamingfast.io:443   (used)
#   base.substreams.pinax.network:443   (alternative)
SUBSTREAMS_ENDPOINT=base-mainnet.streamingfast.io:443
# The durable 'server_...' key from The Graph Market. The endpoints REJECT this
# key directly - it must be exchanged for a JWT. See NOTES.md 7.1.
SUBSTREAMS_API_KEY=
# The short-lived JWT the CLI consumes. Produced by scripts/substreams-auth.sh;
# do not set this by hand.
SUBSTREAMS_API_TOKEN=
# Subgraph Studio key for the Agent0 / ERC-8004 subgraph (G3)
GRAPH_API_KEY=

# ---- Chain ----
BASE_RPC_URL=
USDC_BASE=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# ---- Sink (G1) ----
DATABASE_URL=
